// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

model Profile {
  id    Int     @default(autoincrement()) @id
  name String  @unique
  description  String?
  githubUrl  String?
  linkedinUrl  String?
  skills Skill[]
  experiences Experience[]
  projects Project[]
}

model Skill {
  id          Int     @default(autoincrement()) @id
  name        String
  profileId   Int
  profile     Profile @relation(fields: [profileId], references: [id])
}

model Experience {
  id          Int     @default(autoincrement()) @id
  company     String
  position    String
  startedAt   DateTime
  endedAt     DateTime?
  achievements String?
  profileId   Int
  profile     Profile @relation(fields: [profileId], references: [id])
}

model Project {
  id          Int     @default(autoincrement()) @id
  name        String
  url         String?
  description String?
  profileId   Int
  profile     Profile @relation(fields: [profileId], references: [id])
}
